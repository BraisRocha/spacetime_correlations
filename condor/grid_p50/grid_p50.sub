# One job per line of grid_p50_params.txt (flare_duration, flare_intensity, seed).
# Submit with: bash condor/grid_p50/submit_grid_p50.sh
#
# Paths are absolute because the executable is copied to the worker node, so
# nothing can be located relative to this file. Update them if the repository
# moves. The Python environment is picked by run_grid_p50.sh, not here.

getenv     = PATH,HOME,LD_LIBRARY_PATH,CONDA_PREFIX,CONDA_DEFAULT_ENV
executable = /lustre/Auger/brais.rocha/spacetime_correlations/condor/grid_p50/run_grid_p50.sh

output = /lustre/Auger/brais.rocha/spacetime_correlations/logs/condor/grid_p50/grid_p50_$(submission_id)_$(Process).out
error  = /lustre/Auger/brais.rocha/spacetime_correlations/logs/condor/grid_p50/grid_p50_$(submission_id)_$(Process).err
log    = /lustre/Auger/brais.rocha/spacetime_correlations/logs/condor/grid_p50/grid_p50_$(submission_id)_$(Process).log

should_transfer_files   = Yes
when_to_transfer_output = ON_EXIT
+flavour                = "xshort"
arguments               = $(flare_duration) $(flare_intensity) $(seed) $(Process) $(submission_id)
request_memory          = 2G

queue flare_duration, flare_intensity, seed from /lustre/Auger/brais.rocha/spacetime_correlations/condor/grid_p50/grid_p50_params.txt
