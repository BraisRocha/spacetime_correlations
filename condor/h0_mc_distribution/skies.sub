# One job per line of params.txt (dataset, k_start, k_stop, seed): the
# Lambda values of every pixel in the skies k_start ... k_stop - 1.
# Submit with: bash condor/h0_mc_distribution/submit_h0_mc.sh
#
# Paths are absolute because the executable is copied to the worker node, so
# nothing can be located relative to this file. Update them if the repository
# moves. The Python environment is picked by run_h0_mc.sh, not here.
#
# submission_id is set by the submitting script and names the scratch
# directory of this submission, where params.txt and prepare.npz are read
# and the results are written. Every submission reads its own params.txt,
# so submissions made one after another do not mix their jobs. There is no
# "log" command: the event log of the whole submission is one of the files
# DAGMan keeps, next to the .dag.

getenv     = PATH,HOME,LD_LIBRARY_PATH,CONDA_PREFIX,CONDA_DEFAULT_ENV
executable = /lustre/Auger/brais.rocha/spacetime_correlations/condor/h0_mc_distribution/run_h0_mc.sh

output = /lustre/Auger/brais.rocha/spacetime_correlations/scratch/h0_mc_distribution/$(submission_id)/skies_k$(k_start).out
error  = /lustre/Auger/brais.rocha/spacetime_correlations/scratch/h0_mc_distribution/$(submission_id)/skies_k$(k_start).err

should_transfer_files   = Yes
when_to_transfer_output = ON_EXIT
+flavour                = "short"
arguments               = skies --dataset $(dataset) --k-start $(k_start) --k-stop $(k_stop) --seed $(seed) --scratch-dir /lustre/Auger/brais.rocha/spacetime_correlations/scratch/h0_mc_distribution/$(submission_id)
request_memory          = 2560M

queue dataset, k_start, k_stop, seed from /lustre/Auger/brais.rocha/spacetime_correlations/scratch/h0_mc_distribution/$(submission_id)/params.txt
