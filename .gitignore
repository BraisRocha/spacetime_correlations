__pycache__/
*.pyc
.vscode/
output/
spacetimecorr.egg-info/
notebook.txt
# Parameter grids are rebuilt by each submit script, so they are not tracked.
# (HTCondor job logs are ignored by logs/condor/.gitignore.)
