stc_venv/
__pycache__/
*.pyc
.vscode/
output/
spacetimecorr.egg-info/
notebook.txt
# Parameter grids are rebuilt by each submit.sh, so they are not tracked.
# (HTCondor job logs are ignored by condor/logs/.gitignore.)
condor/*/params.txt
condor/*/params.txt.tmp
# Track the inputs/ folder structure but not the (large/local) data files
inputs/*
!inputs/catalogs/
inputs/catalogs/*
!inputs/catalogs/.gitkeep
!inputs/catalogs/README.md
