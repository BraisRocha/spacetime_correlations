# Set the font attributes
font.family: serif
font.size: 8

# Enable latex rendering
text.usetex: True

# Default attributes of axes
figure.titlesize: 8
axes.titlesize: 8
axes.linewidth: .5
axes.labelsize: 8

# tick marks
xtick.top : False
ytick.right : False
# xtick.direction : out
# ytick.direction : out

xtick.major.width: .5
ytick.major.width: .5
xtick.minor.width: .3
ytick.minor.width: .3

xtick.labelsize: 8
ytick.labelsize: 8
xtick.minor.visible : False
ytick.minor.visible : True

axes.formatter.use_mathtext : True
axes.formatter.useoffset : False

# Default attributes of plots
lines.linewidth: .8
lines.markeredgewidth: .5
#lines.marker: o
#lines.markersize: 2
legend.frameon: False
legend.handlelength: 1.
legend.fontsize: 8
legend.title_fontsize: 8